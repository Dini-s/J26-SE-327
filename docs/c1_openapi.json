  "components": {
    "schemas": {
      "AmbiguitySummary": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "high_risk": {
            "type": "integer",
            "title": "High Risk"
          },
          "asked_by_ai": {
            "type": "integer",
            "title": "Asked By Ai",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "count",
          "high_risk"
        ],
        "title": "AmbiguitySummary"
      },
      "Body_upload_sources_api_projects__pid__sources_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_upload_sources_api_projects__pid__sources_post"
      },
      "DecisionIn": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "edited",
              "rejected"
            ],
            "title": "Decision"
          },
          "edited_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Text"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionIn"
      },
      "DecisionOut": {
        "properties": {
          "uid": {
            "type": "string",
            "title": "Uid"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "edited_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Text"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "uid",
          "decision",
          "updated_at",
          "history"
        ],
        "title": "DecisionOut"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Flags": {
