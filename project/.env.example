NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Further embedding models fused with TF-IDF and the model above in stage 1 (comma-separated, names of folders in models/).
# Not set: the fine-tuned CodeBERT is used when models/c4-codebert exists. Empty value: only TF-IDF + the model above.
EXTRA_EMBEDDING_MODEL_NAMES=c4-codebert
REDIS_URL=redis://localhost:6379/0

# LLM: leave LLM_BASE_URL empty to use OpenAI (needs OPENAI_API_KEY).
# For a self-hosted Ollama server reached through an SSH tunnel:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=gemma2-8k
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_ARTIFACT_CHARS=
LLM_TIMEOUT=

# GitHub App integration (server only; webhook tunnel targets port 8001).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PORT=8001
